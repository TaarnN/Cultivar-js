{
  "name": "cultivar-js",
  "version": "0.1.9",
  "description": "Turn any JavaScript workflow into a cultivatable behavior space with seeded choices, replayable runs, and tunable computational habits.",
  "keywords": [
    "seed",
    "seeded",
    "random",
    "randomization",
    "deterministic",
    "replay",
    "tuning",
    "optimization",
    "search",
    "experimentation",
    "reproducibility",
    "function-wrapper",
    "parameter-tuning",
    "evolutionary-search",
    "procedural-generation",
    "hierarchical",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./errors": {
      "types": "./dist/types/errors.d.ts",
      "import": "./dist/esm/errors.js",
      "require": "./dist/cjs/errors.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "DOCUMENTATION.md",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node ./scripts/smoke-node.mjs",
    "test:bun": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
